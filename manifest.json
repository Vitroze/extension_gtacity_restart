{
  "manifest_version": 3,
  "name": "GtaCity Forum - Restart Time",
  "version": "1.0.2",
  "browser_specific_settings": {
    "gecko": {
      "id": "gtacity-forum-restart-time@local",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "description": "A simple extension that shows the remaining time until the next restart of the GTA City Forum.",
  "content_scripts": [
    {
      "matches": ["*://gtacityrp.fr/index.php"],
      "js": ["script.js"]
    }
  ]
}
